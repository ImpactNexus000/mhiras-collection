// Mhiras Collection — Database Schema
// Run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// AUTH & USERS
// ============================================

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id                      String    @id @default(cuid())
  firstName               String
  lastName                String
  email                   String    @unique
  phone                   String?   @unique
  passwordHash            String?
  role                    Role      @default(CUSTOMER)
  image                   String?
  emailVerified           DateTime?
  verificationCode        String?
  verificationCodeExpires DateTime?
  marketingEmails         Boolean   @default(true)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // Relations
  accounts         Account[]
  sessions         Session[]
  addresses        Address[]
  orders           Order[]
  deliveryRequests DeliveryRequest[]
  cart             Cart?
  wishlist         WishlistItem[]
  reviews             Review[]
  adminOtps           AdminOtp[]
  passwordResetTokens PasswordResetToken[]
  savedCards          SavedCard[]

  @@map("users")
}

// Tokenized payment authorizations Paystack returns after a successful
// charge. Storing the authorization_code lets the customer re-pay future
// orders without re-entering card details. We never store the PAN or CVV —
// just the issuer-issued token + display-safe last4 / exp / brand.
model SavedCard {
  id                String   @id @default(cuid())
  userId            String
  authorizationCode String   @unique
  last4             String
  expMonth          String
  expYear           String
  cardType          String   // "visa" | "mastercard" | "verve" | ...
  bank              String?
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_cards")
}

// Single-use password reset tokens. The plain token only ever leaves the
// server inside the reset email; we store a bcrypt hash so a DB leak
// doesn't let an attacker reset anyone's password.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  consumed  Boolean   @default(false)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// Two-factor signin code for admin accounts. Issued after a successful
// password check on /auth/signin; consumed when the admin enters the code
// on /auth/admin-verify. We keep this as its own table (rather than reusing
// User.verificationCode) so the signup-verification and admin-signin flows
// don't trip over each other.
model AdminOtp {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  consumed  Boolean   @default(false)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("admin_otps")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// ADDRESSES
// ============================================

model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String?  // "Home", "Office", etc.
  firstName String
  lastName  String
  phone     String
  address   String
  city      String
  state     String
  lga       String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders           Order[]
  deliveryRequests DeliveryRequest[]

  @@map("addresses")
}

// ============================================
// PRODUCTS & CATEGORIES
// ============================================

enum Condition {
  LIKE_NEW
  GOOD
  FAIR
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  SOLD_OUT
  ARCHIVED
}

// RETAIL = individual garments sold by size; WHOLESALE = bulk bales for resellers
enum CategoryKind {
  RETAIL
  WHOLESALE
}

model Category {
  id          String       @id @default(cuid())
  name        String       @unique
  slug        String       @unique
  description String?
  image       String?
  kind        CategoryKind @default(RETAIL)
  sizeOptions String?      // comma-separated sizes for retail, e.g. "6,8,10"
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())

  products Product[]

  @@map("categories")
}

model Product {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  description   String?       @db.Text
  categoryId    String
  size          String?
  condition     Condition     @default(GOOD)
  sellingPrice  Int           // stored in kobo (smallest unit) or whole naira
  originalPrice Int?
  stock         Int           @default(1)
  weight        Float?        // kg
  status        ProductStatus @default(DRAFT)
  featured      Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  category      Category            @relation(fields: [categoryId], references: [id])
  images        ProductImage[]
  orderItems    OrderItem[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  reviews       Review[]
  collections   CollectionProduct[]

  @@index([categoryId])
  @@index([status])
  @@index([slug])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

// ============================================
// COLLECTIONS (curated groupings)
// ============================================

model Collection {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  image       String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  products CollectionProduct[]

  @@map("collections")
}

model CollectionProduct {
  collectionId String
  productId    String
  sortOrder    Int @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@map("collection_products")
}

// ============================================
// CART
// ============================================

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  quantity  Int    @default(1)
  size      String @default("") // chosen size; "" for products with no size

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, size])
  @@map("cart_items")
}

// ============================================
// WISHLIST
// ============================================

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

// ============================================
// ORDERS
// ============================================

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  STOCKPILED // paid, items held in the customer's stockpile awaiting a delivery request
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  PAY_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// IMMEDIATE = ship right away; STOCKPILE = hold paid items until a delivery request
enum FulfillmentType {
  IMMEDIATE
  STOCKPILE
}

enum DeliveryRequestStatus {
  PENDING_PAYMENT // customer selected stockpiled items, delivery fee not yet paid
  PAID            // delivery fee paid, awaiting fulfilment
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id                 String          @id @default(cuid())
  orderNumber        String          @unique // e.g. MH-2024-0847
  userId             String
  addressId          String?         // null for stockpile orders (no delivery address at checkout)
  status             OrderStatus     @default(PENDING)
  fulfillmentType    FulfillmentType @default(IMMEDIATE)
  stockpileExpiresAt DateTime?       // set on stockpile orders: deadline to request delivery
  paymentMethod      PaymentMethod
  paymentStatus      PaymentStatus   @default(PENDING)
  paymentRef         String?         // Paystack/Flutterwave reference
  subtotal           Int
  deliveryFee        Int
  discount           Int             @default(0)
  total              Int
  promoCodeId        String?
  trackingNumber     String?
  notes              String?         @db.Text
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  // Relations
  user      User        @relation(fields: [userId], references: [id])
  address   Address?    @relation(fields: [addressId], references: [id])
  promoCode PromoCode?  @relation(fields: [promoCodeId], references: [id])
  items     OrderItem[]
  timeline  OrderEvent[]

  @@index([userId])
  @@index([status])
  @@index([orderNumber])
  @@map("orders")
}

model OrderItem {
  id                String @id @default(cuid())
  orderId           String
  productId         String
  quantity          Int
  price             Int     // price at time of purchase
  size              String?
  deliveryRequestId String? // null = still in stockpile; set = assigned to a delivery request

  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product          @relation(fields: [productId], references: [id])
  deliveryRequest DeliveryRequest? @relation(fields: [deliveryRequestId], references: [id], onDelete: SetNull)

  @@index([deliveryRequestId])
  @@map("order_items")
}

// A consolidated delivery of items pulled from a customer's stockpile.
model DeliveryRequest {
  id             String                @id @default(cuid())
  requestNumber  String                @unique // e.g. DR-2026-0001
  userId         String
  addressId      String
  deliveryFee    Int
  status         DeliveryRequestStatus @default(PENDING_PAYMENT)
  paymentStatus  PaymentStatus         @default(PENDING)
  paymentRef     String?
  trackingNumber String?
  notes          String?               @db.Text
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  user    User        @relation(fields: [userId], references: [id])
  address Address     @relation(fields: [addressId], references: [id])
  items   OrderItem[]

  @@index([userId])
  @@index([status])
  @@map("delivery_requests")
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  status    String   // human-readable event
  note      String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_events")
}

// ============================================
// PROMO CODES
// ============================================

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_DELIVERY
}

model PromoCode {
  id            String       @id @default(cuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Int          // percentage (e.g. 20) or amount in naira
  minOrder      Int?         // minimum order total to qualify
  maxUses       Int?         // null = unlimited
  usedCount     Int          @default(0)
  startsAt      DateTime?
  expiresAt     DateTime?
  isActive      Boolean      @default(true)
  appliesTo     String?      // category slug or null for all
  createdAt     DateTime     @default(now())

  orders Order[]

  @@map("promo_codes")
}

// ============================================
// DELIVERY ZONES
// ============================================

model DeliveryZone {
  id           String @id @default(cuid())
  name         String // "Lagos Mainland", "Nationwide"
  states       String // comma-separated states
  fee          Int    // delivery fee in naira
  estimateDays String // "1-2 days"
  isActive     Boolean @default(true)
  sortOrder    Int     @default(0)

  @@map("delivery_zones")
}

// ============================================
// REVIEWS
// ============================================

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int      // 1-5
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("reviews")
}

// ============================================
// STORE SETTINGS
// ============================================

// Singleton row (id = "singleton") holding admin-configurable store settings.
// Newsletter signups from the footer / homepage forms. We collect emails
// only (Brevo handles transactional but Mhiras can blast a new-arrivals
// email to this list when there's a drop). `unsubscribedAt` makes opt-out
// reversible without a destructive delete.
model Subscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  source         String    @default("footer") // "footer" | "homepage" | other
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([createdAt])
  @@map("subscribers")
}

model StoreSettings {
  id                   String   @id @default("singleton")
  stockpileExpiryDays  Int      @default(30) // days a customer has to request delivery
  storeName            String   @default("Mhiras Collection")
  contactEmail         String   @default("hello@mhirascollection.com")
  whatsappNumber       String   @default("+234 801 234 5678")
  instagramHandle      String   @default("@mhirascollection")
  announcementText     String   @default("New arrivals every week — Free delivery on retail orders over ₦100,000")
  announcementVisible  Boolean  @default(true)
  // Bank transfer payment instructions (shown on checkout + order page when
  // the customer picks bank transfer). Mhiras edits these in /admin/settings.
  bankName             String   @default("GTBank")
  bankAccountNumber    String   @default("0123456789")
  bankAccountName      String   @default("Mhiras Collection")
  updatedAt            DateTime @updatedAt

  @@map("store_settings")
}
